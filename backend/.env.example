# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/invoice_reviewer

# Flask session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Google AI API key with Gemini access
GEMINI_API_KEY=your-gemini-api-key-here

# Absolute path where uploaded invoice files are stored
UPLOAD_FOLDER=/tmp/invoice_uploads

# development or production
FLASK_ENV=development

# Comma-separated allowed frontend origins for CORS (dev defaults shown)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
