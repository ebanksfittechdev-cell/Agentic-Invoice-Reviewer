# URL the Vite dev server proxies /api requests to.
# Use 127.0.0.1 (IPv4) for a backend running on the same machine.
# For a backend on another machine, use that machine's IP and run
# `flask run --host=0.0.0.0` on the backend.
VITE_API_PROXY=http://127.0.0.1:5000

# Answer /api calls from the in-memory mock backend (src/api/mock/).
# Set to "false" to hit the real Flask server through the proxy above.
VITE_USE_MOCKS=true
